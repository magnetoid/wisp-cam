# Wisp Cam — copy to .env and fill in. Everything here is server-side only.

# --- Core -------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Every browser origin the app is served from, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Signs anonymous session tokens. REQUIRED in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_SECONDS=21600

# --- Frontend build ---------------------------------------------------------
# Vite inlines this at BUILD time; changing it requires a rebuild.
VITE_SERVER_URL=http://localhost:8080

# --- Bot gate (Cloudflare Turnstile) ----------------------------------------
# Leave blank in development to skip the bot check.
# Create at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- TURN relay -------------------------------------------------------------
# Without a relay, roughly 15-20% of real connections cannot traverse NAT and
# fail silently. Public STUN alone is only adequate for local development.
#
# Option A — self-hosted coturn (what docker-compose.yml runs):
TURN_URLS=turn:turn.wisp.best:3478?transport=udp,turn:turn.wisp.best:3478?transport=tcp,turns:turn.wisp.best:5349?transport=tcp
# Must match coturn's static-auth-secret exactly. openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
TURN_TTL_SECONDS=7200

# coturn container settings
TURN_REALM=turn.wisp.best
# The host's public IPv4. A wrong value produces unreachable ICE candidates.
TURN_EXTERNAL_IP=

# Option B — Cloudflare Realtime TURN, used only when TURN_URLS is unset.
# 1,000 GB/month free. https://dash.cloudflare.com/?to=/:account/realtime/turn
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Abuse handling ---------------------------------------------------------
# Published in the terms and privacy policy. Must be a monitored mailbox.
ABUSE_CONTACT_EMAIL=abuse@wisp.best

# Where reports, evidence and ban state live. A volume in production.
DATA_DIR=./data

# Retention for connection and pairing metadata, in days.
LOG_RETENTION_DAYS=30

# --- Local docker-compose port mapping --------------------------------------
SIGNALING_PORT=8080
WEB_PORT=8081

# --- Tuning (optional) ------------------------------------------------------
MATCH_TICK_MS=200
RECENT_PARTNER_TTL_MS=300000
REMATCH_FALLBACK_MS=15000
SESSIONS_PER_IP_PER_HOUR=20
JOINS_PER_MINUTE=60
CHAT_PER_TEN_SECONDS=15
