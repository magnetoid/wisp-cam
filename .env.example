# Copy to .env and fill in. Everything here is server-side only.

# --- Core -------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Browser origins allowed to reach the signaling server (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Signs anonymous session tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_TTL_SECONDS=21600

# --- Bot gate (Cloudflare Turnstile) ----------------------------------------
# Leave blank in development to skip the bot check.
# Create at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- TURN relay (Cloudflare Realtime) ---------------------------------------
# Without this, roughly 15-20% of real connections cannot traverse NAT and
# will silently fail. Free tier covers 1,000 GB/month.
# Create at https://dash.cloudflare.com/?to=/:account/realtime/turn
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_TTL_SECONDS=7200

# --- Abuse handling ---------------------------------------------------------
# Published in the terms and privacy policy. Use a real, monitored address.
ABUSE_CONTACT_EMAIL=abuse@example.com

# Where reports and ban state live. On Fly.io this should be a mounted volume.
DATA_DIR=./data

# Retention for connection and pairing metadata, in days.
LOG_RETENTION_DAYS=30

# --- Tuning (optional) ------------------------------------------------------
MATCH_TICK_MS=200
RECENT_PARTNER_TTL_MS=300000
REMATCH_FALLBACK_MS=15000
SESSIONS_PER_IP_PER_HOUR=20
JOINS_PER_MINUTE=60
CHAT_PER_TEN_SECONDS=15
